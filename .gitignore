# Allowlist: ignore everything, then un-ignore the portable config set.
# New files/dirs Claude Code invents are ignored by default.
*
!*/
!/.gitignore
!/CLAUDE.md
!/RTK.md
!/user_*.md
!/agents/**
!/skills/**
!/docs/**
!/scripts/**
!/settings.json

# Re-ignore session data, caches, and reinstallable dirs surfaced by !*/
/projects/
/sessions/
/session-env/
/tasks/
/todos/
/file-history/
/shell-snapshots/
/paste-cache/
/backups/
/telemetry/
/cache/
/plugins/
/ide/
.DS_Store

# Tool-managed skill dirs (Superset plugin, claude.ai synced skills, deletion trash)
/skills/.trash/
/skills/superset/
/skills/synced/
